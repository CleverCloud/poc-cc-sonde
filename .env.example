# Example environment variables for POC Sonde
# Copy this file to .env and customize for your environment

# Redis Configuration (for state persistence)
# Option 1: Use a complete Redis URL
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:mypassword@localhost:6379

# Option 2: Use separate Redis configuration variables
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=mypassword

# WarpScript Configuration (required for WarpScript probes)
# WARP_ENDPOINT=https://warp.example.com/api/v0/exec
# WARP_TOKEN=YOUR_READ_TOKEN_HERE

# Config web UI (single-page VueJS, HTTP Basic Auth).
# Both variables must be set (and non-empty) to enable the UI; otherwise only
# the /healthz endpoint is served. The UI is hosted on the health check server
# (see --healthcheck / --healthcheck-port). On startup the config is read from
# Redis if present, otherwise bootstrapped from the TOML file and persisted.
# CONFIG_UI_USER=admin
# CONFIG_UI_PASSWORD=change-me

# Agent metrics ingestion (for agent_probes).
# Local agents POST CPU/RAM to /api/metrics/<app_id>. If set, the agent must
# send this value in the X-Agent-Token header (otherwise the endpoint is open).
# The ingest endpoint only accepts app ids that have an agent_probe declared.
# AGENT_INGEST_TOKEN=shared-secret

# Logging configuration
# RUST_LOG=poc_sonde=debug
# RUST_LOG=info
